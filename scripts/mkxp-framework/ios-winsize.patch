+					"[gl-meta] after screen blit: vpMid=%d,%d px={%d,%d,%d,%d} err=0x%x\n",
+					vp2[2] / 2, vp2[3] / 2, px[0], px[1], px[2], px[3],
+					(unsigned)glGetError());
+			}
+		}
+
 		glState.blend.pop();
 
 		if (smooth)
@@ -230,7 +313,11 @@ void blitRectangle(const IntRect &src, const IntRect &dst, bool smooth)
 void blitEnd()
 {
 	if (!HAVE_NATIVE_BLIT)
+	{
+		glState.scissorBox.pop();
+		glState.scissorTest.pop();
 		glState.viewport.pop();
+	}
 }
 
