diff --git a/src/display/gl/gl-meta.cpp b/src/display/gl/gl-meta.cpp
index ad491f4..7d3884a 100644
--- a/src/display/gl/gl-meta.cpp
+++ b/src/display/gl/gl-meta.cpp
@@ -145,6 +145,12 @@ static void _blitBegin(FBO::ID fbo, const Vec2i &size)
 		FBO::bind(fbo);
 		glState.viewport.pushSet(IntRect(0, 0, size.x, size.y));
 
+		/* iOS: scissor 框在 GLState 构造时被初始化成 defScreen(512x384) 且永不更新，
+		 * 而画面放大后落在 y=585..1206 —— 若场景合成遗留了 scissor 测试，整块画面会
+		 * 被 512x384 的框完全裁掉(表现为黑屏)。blit 期间禁用并放开到整个目标区域。 */
+		glState.scissorTest.pushSet(false);
+		glState.scissorBox.pushSet(IntRect(0, 0, size.x, size.y));
+
 		if (shState->config().lanczos3Scaling)
 		{
 			Lanczos3Shader &shader = shState->shaders().lanczos3;
@@ -230,7 +236,11 @@ void blitRectangle(const IntRect &src, const IntRect &dst, bool smooth)
 void blitEnd()
 {
 	if (!HAVE_NATIVE_BLIT)
+	{
+		glState.scissorBox.pop();
+		glState.scissorTest.pop();
 		glState.viewport.pop();
+	}
 }
 
 }
