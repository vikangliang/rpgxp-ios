+		}
+
+		/* iOS 诊断：blit 绘制后立刻看一眼目标帧缓冲(仅屏幕 blit, fbo=0) */
+		{
+			static int afterLogged = 0;
+			GLint fbAfter = 0;
+			glGetIntegerv(GL_FRAMEBUFFER_BINDING, &fbAfter);
