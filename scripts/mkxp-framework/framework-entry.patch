+#include "audio.h"
+#include "sharedstate.h"
+#include "binding-util.h"
+#include "exception.h"
+
+/* Essentials (RGSS1) 的 Audio 模块包装会把 track 参数以 nil 传入
+ * （如 Audio.bgm_play(name, vol, pitch, pos, nil)），而上游绑定把这些
+ * 可选参数声明为 'i'（要求 Fixnum）。nil 会触发 rb_int_arg 抛
+ * "Argument N: Expected fixnum"，且 Essentials 只 rescue ArgumentError
+ * 而非 TypeError，导致直接崩溃。这里统一把 track 改为 'o'（任意类型）
+ * 捕获，仅当其为 Numeric 时才取用，否则沿用默认值，兼容 RGSS1。 */
+#define COERCE_TRACK(trackVar, trackVal) \
+    do { \
+        if (!NIL_P(trackVal) && rb_obj_is_kind_of(trackVal, rb_cNumeric)) \
+            (trackVar) = NUM2INT(trackVal); \
+    } while (0)
+
+#define DEF_PLAY_STOP_POS(entity) \
+	RB_METHOD(audio_##entity##Play) \
+	{ \
+		RB_UNUSED_PARAM; \
+		const char *filename; \
+		int volume = 100; \
+		int pitch = 100; \
+		double pos = 0.0; \
+		VALUE dummy = Qnil; \
+        rb_get_args(argc, argv, "z|iifo", &filename, &volume, &pitch, &pos, &dummy RB_ARG_END); \
+		(void)dummy; \
+		GUARD_EXC( shState->audio().entity##Play(filename, volume, pitch, pos); ) \
+		return Qnil; \
+	} \
+	RB_METHOD(audio_##entity##Stop) \
+	{ \
+		RB_UNUSED_PARAM; \
+		shState->audio().entity##Stop(); \
+		return Qnil; \
+	} \
+	RB_METHOD(audio_##entity##Pos) \
+	{ \
+		RB_UNUSED_PARAM; \
+		return rb_float_new(shState->audio().entity##Pos()); \
+	}
+
+#define DEF_PLAY_STOP(entity) \
+	RB_METHOD(audio_##entity##Play) \
+	{ \
+		RB_UNUSED_PARAM; \
+		const char *filename; \
+		int volume = 100; \
+		int pitch = 100; \
+		VALUE dummy = Qnil; \
+		rb_get_args(argc, argv, "z|iio", &filename, &volume, &pitch, &dummy RB_ARG_END); \
+		(void)dummy; \
+		GUARD_EXC( shState->audio().entity##Play(filename, volume, pitch); ) \
+		return Qnil; \
+	} \
+	RB_METHOD(audio_##entity##Stop) \
+	{ \
+		RB_UNUSED_PARAM; \
+		shState->audio().entity##Stop(); \
+		return Qnil; \
+	}
+
+#define DEF_FADE(entity) \
+RB_METHOD(audio_##entity##Fade) \
+{ \
+	RB_UNUSED_PARAM; \
+	int time; \
+	VALUE dummy = Qnil; \
+	rb_get_args(argc, argv, "i|o", &time, &dummy RB_ARG_END); \
+	(void)dummy; \
+	shState->audio().entity##Fade(time); \
+	return Qnil; \
+}
+
+#define DEF_POS(entity) \
+	RB_METHOD(audio_##entity##Pos) \
+	{ \
+		RB_UNUSED_PARAM; \
+		return rb_float_new(shState->audio().entity##Pos()); \
+	}
+
+// DEF_PLAY_STOP_POS( bgm )
+
+RB_METHOD(audio_bgmPlay)
+{
+    RB_UNUSED_PARAM;
+    const char *filename;
+    int volume = 100;
+    int pitch = 100;
+    double pos = 0.0;
+    int track = -127;
+    VALUE trackVal = Qnil;
+    rb_get_args(argc, argv, "z|iifo", &filename, &volume, &pitch, &pos, &trackVal RB_ARG_END);
+    COERCE_TRACK(track, trackVal);
+    GUARD_EXC( shState->audio().bgmPlay(filename, volume, pitch, pos, track); )
+    return Qnil;
+}
+
+RB_METHOD(audio_bgmStop)
+{
+    RB_UNUSED_PARAM;
+    int track = -127;
+    VALUE trackVal = Qnil;
+    rb_get_args(argc, argv, "|o", &trackVal RB_ARG_END);
+    COERCE_TRACK(track, trackVal);
+    shState->audio().bgmStop(track);
+    return Qnil;
+}
+
+RB_METHOD(audio_bgmPos)
+{
+    RB_UNUSED_PARAM;
+    int track = 0;
+    VALUE trackVal = Qnil;
+    rb_get_args(argc, argv, "|o", &trackVal RB_ARG_END);
+    COERCE_TRACK(track, trackVal);
+    return rb_float_new(shState->audio().bgmPos(track));
+}
+
+RB_METHOD(audio_bgmGetVolume)
+{
+    RB_UNUSED_PARAM;
+    int track = -127;
+    VALUE trackVal = Qnil;
+    rb_get_args(argc, argv, "|o", &trackVal RB_ARG_END);
+    COERCE_TRACK(track, trackVal);
+    int ret = 0;
+    GUARD_EXC( ret = shState->audio().bgmGetVolume(track); )
+    return rb_fix_new(ret);
+}
+
+RB_METHOD(audio_bgmSetVolume)
+{
+    RB_UNUSED_PARAM;
+    int volume;
+    int track = -127;
+    VALUE trackVal = Qnil;
+    rb_get_args(argc, argv, "i|o", &volume, &trackVal RB_ARG_END);
+    COERCE_TRACK(track, trackVal);
+    GUARD_EXC( shState->audio().bgmSetVolume(volume, track); )
+    return Qnil;
+}
+
+DEF_PLAY_STOP_POS( bgs )
+
+DEF_PLAY_STOP( me )
+
+//DEF_FADE( bgm )
+RB_METHOD(audio_bgmFade)
+{
+    RB_UNUSED_PARAM;
+    int time;
+    int track = -127;
+    VALUE trackVal = Qnil;
+    rb_get_args(argc, argv, "i|o", &time, &trackVal RB_ARG_END);
+    COERCE_TRACK(track, trackVal);
+    shState->audio().bgmFade(time, track);
+    return Qnil;
+}
+
+DEF_FADE( bgs )
+DEF_FADE( me )
+
+DEF_PLAY_STOP( se )
+
+RB_METHOD(audioSetupMidi)
+{
+	RB_UNUSED_PARAM;
+
+	shState->audio().setupMidi();
+
+	return Qnil;
+}
+
+RB_METHOD(audioReset)
+{
+	RB_UNUSED_PARAM;
+
+	shState->audio().reset();
+
+	return Qnil;
+}
+
+
+#define BIND_PLAY_STOP(entity) \
+	_rb_define_module_function(module, #entity "_play", audio_##entity##Play); \
+	_rb_define_module_function(module, #entity "_stop", audio_##entity##Stop);
+
+#define BIND_FADE(entity) \
+	_rb_define_module_function(module, #entity "_fade", audio_##entity##Fade);
+
+#define BIND_PLAY_STOP_FADE(entity) \
+	BIND_PLAY_STOP(entity) \
+	BIND_FADE(entity)
+
+#define BIND_POS(entity) \
+	_rb_define_module_function(module, #entity "_pos", audio_##entity##Pos);
+
+
+void
+audioBindingInit()
+{
+	VALUE module = rb_define_module("Audio");
+
+	BIND_PLAY_STOP_FADE( bgm );
+    _rb_define_module_function(module, "bgm_volume", audio_bgmGetVolume);
+    _rb_define_module_function(module, "bgm_set_volume", audio_bgmSetVolume);
+	BIND_PLAY_STOP_FADE( bgs );
+	BIND_PLAY_STOP_FADE( me  );
+
+	BIND_POS( bgm );
+	BIND_POS( bgs );
+
+	_rb_define_module_function(module, "setup_midi", audioSetupMidi);
+
+	BIND_PLAY_STOP( se )
+
+	_rb_define_module_function(module, "__reset__", audioReset);
+}
