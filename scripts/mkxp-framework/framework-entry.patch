+	AL::Buffer::ID lastBuf;
+
+	SDL_RWops srcOps;
+
+	struct
+	{
+		ALenum format;
+		ALsizei freq;
+	} stream;
+
+	enum LoopMode
+	{
+		Looped,
+		NotLooped
+	};
