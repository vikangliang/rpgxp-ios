+    // without defining their Encoding::* constants (game scripts reference
+    // Encoding::UTF_8 early -> NameError). Ensure the common ones exist; if an
+    // encoding itself is not registered, log a WARNING (that means the build is
+    // missing the enc objects and needs a build-script fix).
+    {
+        static const char *encs[] = {"UTF-8", "US-ASCII", "ASCII-8BIT", "UTF-16LE",
