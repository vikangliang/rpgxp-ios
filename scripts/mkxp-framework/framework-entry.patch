-    /* For cursive characters, returning the advance
-     * as width yields better results */
-    if (p->font->getItalic() && *endPtr == '\0')
-        TTF_GlyphMetrics(font, ucs2, 0, 0, 0, 0, &w);
-    
-    return IntRect(0, 0, w, h);
-}
