-void EventThread::notifyFrame()
-{
-#ifdef MKXPZ_BUILD_XCODE
-    uint32_t frames = round(shState->graphics().averageFrameRate());
-    updateTouchBarFPSDisplay(frames);
-#endif
-    if (!fps.sendUpdates)
-        return;
-    
-    SDL_Event event;
-#ifdef MKXPZ_BUILD_XCODE
-    event.user.code = frames;
-#else
