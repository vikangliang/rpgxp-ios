+// --------------------
+
+struct BitmapPrivate
+{
+    friend class Bitmap;   // 允许 cpuBlitToPending 访问 Bitmap 私有成员 p
+
+    Bitmap *self;
+    
+    struct {
+        int width;
+        int height;
+        
+        bool enabled;
+        bool playing;
+        bool needsReset;
+        bool loop;
+        std::vector<TEXFBO> frames;
+        float fps;
+        int lastFrame;
+        double startTime, playTime;
+        
+        inline unsigned int currentFrameIRaw() {
+            if (fps <= 0) return lastFrame;
+            return floor(lastFrame + (playTime / (1 / fps)));
+        }
+        
+        unsigned int currentFrameI() {
+            if (!playing || needsReset) return lastFrame;
+            int i = currentFrameIRaw();
+            return (loop) ? fmod(i, frames.size()) : (i > (int)frames.size() - 1) ? (int)frames.size() - 1 : i;
+        }
+        
+        inline TEXFBO &currentFrame() {
+            int i = currentFrameI();
+            return frames[i];
+        }
+        
+        inline void play() {
+            playing = true;
+            needsReset = true;
+        }
+        
+        inline void stop() {
+            lastFrame = currentFrameI();
+            playing = false;
+        }
+        
+        inline void seek(int frame) {
+            lastFrame = clamp(frame, 0, (int)frames.size());
+        }
+        
+        void updateTimer() {
+            if (needsReset) {
+                lastFrame = currentFrameI();
+                playTime = 0;
+                startTime = shState->runTime();
+                needsReset = false;
+                return;
+            }
+            
+            playTime = shState->runTime() - startTime;
+            return;
+        }
+    } animation;
+    
+    sigslot::connection prepareCon;
+    
+    TEXFBO gl;
+    
+    Font *font;
+    
+    /* "Mega surfaces" are a hack to allow Tilesets to be used
+     * whose Bitmaps don't fit into a regular texture. They're
+     * kept in RAM and will throw an error if they're used in
+     * any context other than as Tilesets */
+    SDL_Surface *megaSurface;
+    
+    /* A cached version of the bitmap in client memory, for
+     * getPixel calls. Is invalidated any time the bitmap
+     * is modified */
+    SDL_Surface *surface;
+    SDL_PixelFormat *format;
+    
+    /* The 'tainted' area describes which parts of the
+     * bitmap are not cleared, ie. don't have 0 opacity.
+     * If we're blitting / drawing text to a cleared part
+     * with full opacity, we can disregard any old contents
+     * in the texture and blit to it directly, saving
+     * ourselves the expensive blending calculation */
+    pixman_region16_t tainted;
+
+    /* iOS perf: newly created Bitmaps blit to CPU first and upload once
+     * on first GL use, avoiding thousands of GPU draw calls in
+     * Essentials' AutotileExpander. */
+    bool cpuPending;
+    bool cpuDirty;
+
+    BitmapPrivate(Bitmap *self)
+    : self(self),
+    megaSurface(0),
+    surface(0),
+    cpuPending(false),
+    cpuDirty(false)
+    {
+        format = SDL_AllocFormat(SDL_PIXELFORMAT_ABGR8888);
+        
+        animation.width = 0;
+        animation.height = 0;
+        animation.enabled = false;
+        animation.playing = false;
+        animation.loop = true;
+        animation.playTime = 0;
+        animation.startTime = 0;
+        animation.fps = 0;
+        animation.lastFrame = 0;
+        
+        prepareCon = shState->prepareDraw.connect(&BitmapPrivate::prepare, this);
+        
+        font = &shState->defaultFont();
+        pixman_region_init(&tainted);
+    }
+    
+    ~BitmapPrivate()
+    {
+        prepareCon.disconnect();
+        SDL_FreeFormat(format);
+        pixman_region_fini(&tainted);
+    }
+    
+    /* ---- iOS perf: CPU-pending blit path ----
+     * Newly created Bitmaps accumulate 1:1 blits on a CPU surface and
+     * upload the whole thing once on first GL use, instead of issuing
+     * thousands of GPU draw calls (Essentials AutotileExpander does
+     * 48*frames*4 blits per tileset -> seconds on Metal-GL). */
+    void flushCpuToGL()
+    {
+        if (!cpuDirty || !surface) return;
+        TEX::bind(gl.tex);
+        TEX::uploadSubImage(0, 0, gl.width, gl.height, surface->pixels, GL_RGBA);
+        cpuDirty = false;
+        cpuPending = false;
+    }
+
+    void endCpuPending()
+    {
+        flushCpuToGL();
+        cpuPending = false;
+    }
+
+    bool cpuBlitToPending(const IntRect &destRect, const Bitmap &source, const IntRect &sourceRect)
+    {
+        if (!surface) {
+            allocSurface();
+            SDL_FillRect(surface, 0, 0);   // 新建位图初始透明
+        }
+        SDL_Surface *srcSurf = const_cast<Bitmap&>(source).ensureCpuSurface();
+        if (!srcSurf) return false;
+        SDL_Rect sr = { (Sint16)sourceRect.x, (Sint16)sourceRect.y, (Uint16)sourceRect.w, (Uint16)sourceRect.h };
+        SDL_Rect dr = { (Sint16)destRect.x, (Sint16)destRect.y, (Uint16)destRect.w, (Uint16)destRect.h };
+        if (sr.w != dr.w || sr.h != dr.h) return false;   // 仅支持 1:1
+        SDL_SetSurfaceBlendMode(srcSurf, SDL_BLENDMODE_NONE);
+        if (SDL_BlitSurface(srcSurf, &sr, surface, &dr) != 0) return false;
+        cpuDirty = true;
+        return true;
+    }
+
+    TEXFBO &getGLTypes() {
+        flushCpuToGL();   // 首次用作渲染纹理前上传 CPU 累积内容
+        return (animation.enabled) ? animation.currentFrame() : gl;
+    }
+    
+    void prepare()
+    {
+        if (!animation.enabled || !animation.playing) return;
+        
+        animation.updateTimer();
+    }
+    
+    void allocSurface()
+    {
+        surface = SDL_CreateRGBSurface(0, gl.width, gl.height, format->BitsPerPixel,
+                                       format->Rmask, format->Gmask,
+                                       format->Bmask, format->Amask);
+    }
+    
+    void clearTaintedArea()
+    {
+        pixman_region_fini(&tainted);
+        pixman_region_init(&tainted);
+    }
+    
+    void addTaintedArea(const IntRect &rect)
+    {
+        IntRect norm = normalizedRect(rect);
+        pixman_region_union_rect
+        (&tainted, &tainted, norm.x, norm.y, norm.w, norm.h);
+    }
+    
+    void substractTaintedArea(const IntRect &rect)
+    {
+        if (!touchesTaintedArea(rect))
+            return;
+        
+        pixman_region16_t m_reg;
+        pixman_region_init_rect(&m_reg, rect.x, rect.y, rect.w, rect.h);
+        
+        pixman_region_subtract(&tainted, &m_reg, &tainted);
+        
+        pixman_region_fini(&m_reg);
+    }
+    
+    bool touchesTaintedArea(const IntRect &rect)
+    {
+        pixman_box16_t box;
+        box.x1 = rect.x;
+        box.y1 = rect.y;
+        box.x2 = rect.x + rect.w;
+        box.y2 = rect.y + rect.h;
+        
+        pixman_region_overlap_t result =
+        pixman_region_contains_rectangle(&tainted, &box);
+        
+        return result != PIXMAN_REGION_OUT;
+    }
+    
+    void bindTexture(ShaderBase &shader)
+    {
+        flushCpuToGL();
+        if (animation.enabled) {
+            TEXFBO cframe = animation.currentFrame();
+            TEX::bind(cframe.tex);
+            shader.setTexSize(Vec2i(cframe.width, cframe.height));
+            return;
+        }
+        TEX::bind(gl.tex);
+        shader.setTexSize(Vec2i(gl.width, gl.height));
+    }
+    
+    void bindFBO()
+    {
+        FBO::bind((animation.enabled) ? animation.currentFrame().fbo : gl.fbo);
+    }
+    
+    void pushSetViewport(ShaderBase &shader) const
+    {
+        glState.viewport.pushSet(IntRect(0, 0, gl.width, gl.height));
+        shader.applyViewportProj();
+    }
+    
+    void popViewport() const
+    {
+        glState.viewport.pop();
+    }
+    
+    void blitQuad(Quad &quad)
+    {
+        glState.blend.pushSet(false);
+        quad.draw();
+        glState.blend.pop();
+    }
+    
+    void fillRect(const IntRect &rect,
+                  const Vec4 &color)
+    {
+        bindFBO();
+        
+        glState.scissorTest.pushSet(true);
+        glState.scissorBox.pushSet(normalizedRect(rect));
+        glState.clearColor.pushSet(color);
+        
+        FBO::clear();
+        
+        glState.clearColor.pop();
+        glState.scissorBox.pop();
+        glState.scissorTest.pop();
+    }
+    
+    static void ensureFormat(SDL_Surface *&surf, Uint32 format)
+    {
+        if (surf->format->format == format)
+            return;
+        
+        SDL_Surface *surfConv = SDL_ConvertSurfaceFormat(surf, format, 0);
+        SDL_FreeSurface(surf);
+        surf = surfConv;
+    }
+    
+    void onModified(bool freeSurface = true)
+    {
+        if (cpuPending)
+        {
+            /* CPU-pending: surface is the authoritative source; keep it
+             * so the deferred upload doesn't lose accumulated blits. */
+            self->modified();
+            return;
+        }
+        if (surface && freeSurface)
+        {
+            SDL_FreeSurface(surface);
+            surface = 0;
+        }
+
+        self->modified();
+    }
+};
+
+/* libspng fast-path: decode an already-decrypted PNG buffer directly into an
+ * ABGR8888 SDL_Surface. This skips SDL_image/libpng and the ensureFormat
+ * byte-swap copy (ensureFormat is a no-op once the surface is already
+ * ABGR8888). Returns NULL on any error so the caller can fall back to
+ * IMG_LoadTyped_RW. */
+static SDL_Surface *mkxp_spng_decode_abgr(const uint8_t *png, size_t len)
+{
+    spng_ctx *ctx = spng_ctx_new(0);
+    if (!ctx)
+        return nullptr;
+
+    spng_set_png_buffer(ctx, png, len);
+
+    spng_ihdr ihdr;
+    if (spng_get_ihdr(ctx, &ihdr) != 0)
+    { spng_ctx_free(ctx); return nullptr; }
+
+    if (ihdr.width == 0 || ihdr.height == 0 ||
+        ihdr.width > 65536 || ihdr.height > 65536)
+    { spng_ctx_free(ctx); return nullptr; }
+
+    size_t out_size = 0;
+    if (spng_decoded_image_size(ctx, SPNG_FMT_RGBA8, &out_size) != 0)
+    { spng_ctx_free(ctx); return nullptr; }
+
+    int bpp;
+    Uint32 rMask, gMask, bMask, aMask;
+    SDL_PixelFormatEnumToMasks(SDL_PIXELFORMAT_ABGR8888,
+                               &bpp, &rMask, &gMask, &bMask, &aMask);
+    SDL_Surface *surf = SDL_CreateRGBSurface(0, (int)ihdr.width, (int)ihdr.height,
+                                             bpp, rMask, gMask, bMask, aMask);
+    if (!surf)
+    { spng_ctx_free(ctx); return nullptr; }
+
+    /* 32bpp pitch is exactly width*4; spng's RGBA8 output already matches the
+     * ABGR8888 memory order, so decode straight into the surface. */
+    if ((int)ihdr.width * 4 != surf->pitch ||
+        spng_decode_image(ctx, surf->pixels, out_size, SPNG_FMT_RGBA8, 0) != 0)
+    {
+        SDL_FreeSurface(surf);
+        spng_ctx_free(ctx);
+        return nullptr;
+    }
+
+    spng_ctx_free(ctx);
+    return surf;
+}
+
+struct BitmapOpenHandler : FileSystem::OpenHandler
+{
+    // Non-GIF
+    SDL_Surface *surface;
+    
+    // GIF
+    std::string error;
+    gif_animation *gif;
+    unsigned char *gif_data;
+    size_t gif_data_size;
+    
+    
+    BitmapOpenHandler()
+    : surface(0), gif(0), gif_data(0), gif_data_size(0)
+    {}
+    
+    bool tryRead(SDL_RWops &ops, const char *ext)
+    {
+        if (IMG_isGIF(&ops)) {
+            // Use libnsgif to initialise the gif data
+            gif = new gif_animation;
+            
+            gif_bitmap_callback_vt gif_bitmap_callbacks = {
+                gif_bitmap_create,
+                gif_bitmap_destroy,
+                gif_bitmap_get_buffer,
+                gif_bitmap_set_opaque,
+                gif_bitmap_test_opaque,
+                gif_bitmap_modified
+            };
+            
+            gif_create(gif, &gif_bitmap_callbacks);
+            
+            gif_data_size = ops.size(&ops);
+            
+            gif_data = new unsigned char[gif_data_size];
+            ops.seek(&ops, 0, RW_SEEK_SET);
+            ops.read(&ops, gif_data, gif_data_size, 1);
+            
+            int status;
+            do {
+                status = gif_initialise(gif, gif_data_size, gif_data);
+                if (status != GIF_OK && status != GIF_WORKING) {
+                    gif_finalise(gif);
+                    delete gif;
+                    delete gif_data;
+                    error = "Failed to initialize GIF (Error " + std::to_string(status) + ")";
+                    return false;
+                }
+            } while (status != GIF_OK);
+            
+            // Decode the first frame
+            status = gif_decode_frame(gif, 0);
+            if (status != GIF_OK && status != GIF_WORKING) {
+                error = "Failed to decode first GIF frame. (Error " + std::to_string(status) + ")";
+                gif_finalise(gif);
+                delete gif;
+                delete gif_data;
+                return false;
+            }
+        } else {
+            static int s_spngOk = 0, s_spngFail = 0;
+            if (mkxp_ios_spng_disabled()) {
+                surface = IMG_LoadTyped_RW(&ops, 1, ext);
+                return (surface || gif);
+            }
+            Sint64 _sz = ops.size(&ops);
+            if (_sz > 0 && _sz <= (Sint64)(64 * 1024 * 1024)) {
+                uint8_t *_buf = (uint8_t*)malloc((size_t)_sz);
+                if (_buf) {
+                    ops.seek(&ops, 0, RW_SEEK_SET);
+                    if (ops.read(&ops, _buf, 1, (size_t)_sz) == (size_t)_sz)
+                        surface = mkxp_spng_decode_abgr(_buf, (size_t)_sz);
+                    free(_buf);
+                }
+            }
+            if (!surface) {
+                ops.seek(&ops, 0, RW_SEEK_SET);
+                surface = IMG_LoadTyped_RW(&ops, 1, ext);
+                if (s_spngFail++ < 3)
+                    fprintf(stderr, "rgss: spng fallback (IMG_LoadTyped_RW) for %s\n", ext);
+            } else {
+                /* spng consumed the stream; IMG_LoadTyped_RW won't run, so
+                 * close the phys file ourselves (mirrors freesrc=1). */
+                SDL_RWclose(&ops);
+                if (s_spngOk++ < 3)
+                    fprintf(stderr, "rgss: spng decode ok for %s\n", ext);
+            }
+        }
+        return (surface || gif);
+    }
+};
+
+/* ---- Decoded-pixel LRU cache (iOS perf) ----
+ * Stores post-ensureFormat ABGR8888 pixels keyed by normalized filename.
+ * Caches the most expensive part (RGSSAD decrypt + PNG decode) so that
+ * returning to a map / ending a battle re-uses decoded pixels instead of
+ * re-decoding from scratch. Each Bitmap gets its own copy of the cached
+ * bytes, so the cache only holds immutable pixels and can never be
+ * corrupted by a later blt/modification of a Bitmap. ---- */
+namespace {
+
+struct DecodedPixelCache
+{
+    struct Entry
+    {
+        int w, h;
+        std::vector<uint8_t> px; // ABGR8888
+    };
+
+    std::unordered_map<std::string, Entry> map;
+    std::list<std::string> lru; // front = most recent
+    int64_t totalBytes;
+    /* Pinned tilesets (mega-surfaces): never evicted by LRU pressure, so map
+     * re-entry never re-decodes the giant tileset (no 150ms hitch). Bounded by
+     * count (PINNED_MAX) to avoid the old OOM: pinning many tilesets + full LRU
+     * pushed the working set past 800MB. We keep only the few tilesets actually
+     * in play (~<=160MB) - safe, and kills the recurring re-decode stall. */
+    std::unordered_map<std::string, Entry> pinned;
+    std::list<std::string> pinnedLru; // FIFO for pinned
+    int64_t pinnedBytes;
+    int64_t hits, miss, ops;
+    static const int64_t CAP_BYTES = 96LL * 1024 * 1024;
+    static const size_t PINNED_MAX = 4;
+    SDL_mutex *mut;
+
+    DecodedPixelCache()
+        : totalBytes(0), pinnedBytes(0), hits(0), miss(0), ops(0)
+    { mut = SDL_CreateMutex(); }
+
+    static std::string normalizeKey(const std::string &k)
+    {
+        std::string s = k;
+        for (auto &c : s) if (c == '\\') c = '/';
+        while (s.size() >= 2 && s[0] == '.' && s[1] == '/') s = s.substr(2);
+        for (auto &c : s) if (c >= 'A' && c <= 'Z') c = (char)(c + 32);
+        return s;
+    }
+
+    bool get(const std::string &keyIn, int &w, int &h, std::vector<uint8_t> &out)
+    {
+        std::string key = normalizeKey(keyIn);
+        SDL_LockMutex(mut);
+        auto it = pinned.find(key);
+        bool hit = (it != pinned.end());
+        if (hit)
+        {
+            w = it->second.w; h = it->second.h; out = it->second.px;
+            hits++;
+            SDL_UnlockMutex(mut);
+            return true;
+        }
+        it = map.find(key);
+        hit = (it != map.end());
+        if (hit)
+        {
+            w = it->second.w; h = it->second.h; out = it->second.px;
+            lru.remove(key); lru.push_front(key);
+            hits++;
+        }
+        SDL_UnlockMutex(mut);
+        return hit;
+    }
+
+    void put(const std::string &keyIn, int w, int h, const uint8_t *p, size_t n, bool isMega = false)
+    {
+        std::string key = normalizeKey(keyIn);
+        SDL_LockMutex(mut);
+        int64_t add = (int64_t)n;
+        if (isMega)
+        {
+            /* Pin the giant tileset: never evicted by LRU pressure, so map
+             * re-entry never re-decodes it (no 150ms hitch). Bounded by
+             * PINNED_MAX count to keep memory safe (a few tilesets in play). */
+            auto eit = pinned.find(key);
+            if (eit != pinned.end())
+            {
+                pinnedBytes -= (int64_t)eit->second.px.size();
+                pinned.erase(eit); pinnedLru.remove(key);
+            }
+            Entry e; e.w = w; e.h = h; e.px.assign(p, p + n);
+            pinned[key] = e;
+            pinnedLru.remove(key); pinnedLru.push_front(key);
+            pinnedBytes += add;
+            fprintf(stderr, "rgss: tileset pinned: %s (%dx%d, pinned=%zu)\n",
+                    key.c_str(), w, h, pinned.size());
+            while (pinned.size() > PINNED_MAX)
+            {
+                std::string oldk = pinnedLru.back();
+                auto oit = pinned.find(oldk);
+                if (oit == pinned.end()) { pinnedLru.pop_back(); continue; }
+                pinnedBytes -= (int64_t)oit->second.px.size();
+                pinned.erase(oit); pinnedLru.pop_back();
+            }
+            miss++; ops++;
+            if (ops % 32 == 0)
+                fprintf(stderr, "rgss: decode-cache hits=%lld miss=%lld (pinned=%zu)\n",
+                        (long long)hits, (long long)miss, pinned.size());
+            SDL_UnlockMutex(mut);
+            return;
+        }
+        if (add > CAP_BYTES) { miss++; ops++; SDL_UnlockMutex(mut); return; }
+        while (totalBytes + add > CAP_BYTES && lru.size() > 0)
+        {
+            std::string oldk = lru.back();
+            auto oit = map.find(oldk);
+            if (oit == map.end()) { lru.pop_back(); continue; }
+            totalBytes -= (int64_t)oit->second.px.size();
+            map.erase(oit);
+            lru.pop_back();
+        }
+        Entry e; e.w = w; e.h = h; e.px.assign(p, p + n);
+        map[key] = e;
+        lru.remove(key); lru.push_front(key);
+        totalBytes += add;
+        miss++; ops++;
+        if (ops % 32 == 0)
+            fprintf(stderr, "rgss: decode-cache hits=%lld miss=%lld\n", (long long)hits, (long long)miss);
+        SDL_UnlockMutex(mut);
+    }
+
+    /* A/B 开关切换 spng 时清空缓存：确保后续 bitmap 用新设置重新解码 */
+    void clear()
+    {
+        SDL_LockMutex(mut);
+        map.clear();
+        lru.clear();
+        totalBytes = 0;
+        pinned.clear();
+        pinnedLru.clear();
+        pinnedBytes = 0;
+        SDL_UnlockMutex(mut);
+    }
+};
+
+DecodedPixelCache g_decodedPixelCache;
+
+extern "C" void mkxp_ios_clear_decoded_cache()
+{
+    g_decodedPixelCache.clear();
+    fprintf(stderr, "rgss: decoded pixel cache cleared (spng toggle)\n");
+}
+
+} // namespace
+
+Bitmap::Bitmap(const char *filename)
+{
+    /* Fast path: decoded-pixel cache. Skips RGSSAD decrypt + PNG decode
+     * entirely on re-entry (battle end, map return). Cached pixels are
+     * post-ensureFormat ABGR8888 bytes, identical to the normal path's
+     * imgSurf->pixels, so we upload them DIRECTLY (no SDL surface, no
+     * re-decode) to reproduce the exact same GPU bytes. The (rare)
+     * mega-surface case is skipped and falls through to normal decode. */
+    {
+        int cw = 0, ch = 0;
+        std::vector<uint8_t> cpx;
+        if (g_decodedPixelCache.get(filename, cw, ch, cpx))
+        {
+            p = new BitmapPrivate(this);
+            if (cw > glState.caps.maxTexSize || ch > glState.caps.maxTexSize)
+            {
+                /* Mega-size cached asset (e.g. 256x38660 tileset): rebuild
+                 * the mega surface from cached pixels - skips PNG decode. */
+                SDL_Surface *ms = SDL_CreateRGBSurfaceWithFormat(0, cw, ch, 32, SDL_PIXELFORMAT_ABGR8888);
+                for (int y = 0; y < ch; ++y)
+                    memcpy((uint8_t*)ms->pixels + (size_t)y * ms->pitch,
+                           cpx.data() + (size_t)y * cw * 4, (size_t)cw * 4);
+                p->megaSurface = ms;
+                SDL_SetSurfaceBlendMode(p->megaSurface, SDL_BLENDMODE_NONE);
+            }
+            else
+            {
+                TEXFBO tex = shState->texPool().request(cw, ch);
+                p->gl = tex;
+                TEX::bind(p->gl.tex);
+                TEX::uploadImage(cw, ch, cpx.data(), GL_RGBA);
+                p->addTaintedArea(rect());
+            }
+            return;
+        }
+    }
+
+    uint32_t _decT0 = SDL_GetTicks();
+
+    BitmapOpenHandler handler;
+    shState->fileSystem().openRead(handler, filename);
+    
+    if (!handler.error.empty()) {
+        // iOS engine adaptation: missing/broken bitmap used to throw -> Ruby
+        // event Script -> EventScriptError (Section033:177 'rescue in execute_script'
+        // hard-crashes the game on a single bad asset - confirmed via mkxp.log when
+        // the user-imported game zip is missing Graphics/Maps/*.png). Fall back to a
+        // 1x1 transparent GL texture so the game continues.
+        Debug() << "mkxp: bitmap load error" << filename << handler.error.c_str() << "(empty 1x1 fallback)";
+        SDL_Surface *fb_surf = SDL_CreateRGBSurfaceWithFormat(0, 1, 1, 32, SDL_PIXELFORMAT_ABGR8888);
+        if (!fb_surf) throw Exception(Exception::SDLError, "mkxp: fallback alloc failed");
+        p = new BitmapPrivate(this);
+        TEXFBO tex = shState->texPool().request(1, 1);
+        p->gl = tex;
+        TEX::bind(p->gl.tex);
+        TEX::uploadImage(1, 1, fb_surf->pixels, GL_RGBA);
+        SDL_FreeSurface(fb_surf);
+        p->addTaintedArea(rect());
+        return;
+    }
+    else if (!handler.gif && !handler.surface) {
+        Debug() << "mkxp: bitmap missing" << filename << SDL_GetError() << "(empty 1x1 fallback)";
+        SDL_Surface *fb_surf = SDL_CreateRGBSurfaceWithFormat(0, 1, 1, 32, SDL_PIXELFORMAT_ABGR8888);
+        if (!fb_surf) throw Exception(Exception::SDLError, "mkxp: fallback alloc failed");
+        p = new BitmapPrivate(this);
+        TEXFBO tex = shState->texPool().request(1, 1);
+        p->gl = tex;
+        TEX::bind(p->gl.tex);
+        TEX::uploadImage(1, 1, fb_surf->pixels, GL_RGBA);
+        SDL_FreeSurface(fb_surf);
+        p->addTaintedArea(rect());
+        return;
+    }
+    
+    if (handler.gif) {
+        p = new BitmapPrivate(this);
+        
+        if (handler.gif->width >= (uint32_t)glState.caps.maxTexSize || handler.gif->height > (uint32_t)glState.caps.maxTexSize)
+        {
+            throw new Exception(Exception::MKXPError, "Animation too large (%ix%i, max %ix%i)",
+                                handler.gif->width, handler.gif->height, glState.caps.maxTexSize, glState.caps.maxTexSize);
+        }
+        
+        if (handler.gif->frame_count == 1) {
+            TEXFBO texfbo;
+            try {
+                texfbo = shState->texPool().request(handler.gif->width, handler.gif->height);
+            }
+            catch (const Exception &e)
+            {
+                gif_finalise(handler.gif);
+                delete handler.gif;
+                delete handler.gif_data;
+                
+                throw e;
+            }
+            
+            TEX::bind(texfbo.tex);
+            TEX::uploadImage(handler.gif->width, handler.gif->height, handler.gif->frame_image, GL_RGBA);
+            gif_finalise(handler.gif);
+            delete handler.gif;
+            delete handler.gif_data;
+            
+            p->gl = texfbo;
+            p->addTaintedArea(rect());
+            return;
+        }
+        
+        p->animation.enabled = true;
+        p->animation.width = handler.gif->width;
+        p->animation.height = handler.gif->height;
+        
+        // Guess framerate based on the first frame's delay
+        p->animation.fps = 1 / ((float)handler.gif->frames[handler.gif->decoded_frame].frame_delay / 100);
+        if (p->animation.fps < 0) p->animation.fps = shState->graphics().getFrameRate();
+        
+        // Loop gif (Either it's looping or it's not, at the moment)
+        p->animation.loop = handler.gif->loop_count >= 0;
+        
+        int fcount = handler.gif->frame_count;
+        int fcount_partial = handler.gif->frame_count_partial;
+        if (fcount > fcount_partial) {
+            Debug() << "Non-fatal error reading" << filename << ": Only decoded" << fcount_partial << "out of" << fcount << "frames";
+        }
+        for (int i = 0; i < fcount_partial; i++) {
+            if (i > 0) {
+                int status = gif_decode_frame(handler.gif, i);
+                if (status != GIF_OK && status != GIF_WORKING) {
+                    for (TEXFBO &frame : p->animation.frames)
+                        shState->texPool().release(frame);
+                    
+                    gif_finalise(handler.gif);
+                    delete handler.gif;
+                    delete handler.gif_data;
+                    
+                    throw Exception(Exception::MKXPError, "Failed to decode GIF frame %i out of %i (Status %i)",
+                                    i + 1, fcount_partial, status);
+                }
+            }
+            
+            TEXFBO texfbo;
+            try {
+                texfbo = shState->texPool().request(p->animation.width, p->animation.height);
+            }
+            catch (const Exception &e)
+            {
+                for (TEXFBO &frame : p->animation.frames)
+                    shState->texPool().release(frame);
+                
+                gif_finalise(handler.gif);
+                delete handler.gif;
+                delete handler.gif_data;
+                
+                throw e;
+            }
+            
+            TEX::bind(texfbo.tex);
+            TEX::uploadImage(p->animation.width, p->animation.height, handler.gif->frame_image, GL_RGBA);
+            p->animation.frames.push_back(texfbo);
+        }
+        
+        gif_finalise(handler.gif);
+        delete handler.gif;
+        delete handler.gif_data;
+        p->addTaintedArea(rect());
+        return;
+    }
+    
+    SDL_Surface *imgSurf = handler.surface;
+    
+    
+    p->ensureFormat(imgSurf, SDL_PIXELFORMAT_ABGR8888);
+
+    /* Cache decoded pixels for fast re-entry (battle end / map
+     * return). Skip huge surfaces (mega-path) to bound memory. */
+    {
+        uint32_t _dt = SDL_GetTicks() - _decT0;
+        if (_dt > 30)
+            fprintf(stderr, "rgss: slow decode %s t=%ums\n", filename, _dt);
+    }
+    bool _isMega = (imgSurf->w > glState.caps.maxTexSize ||
+                    imgSurf->h > glState.caps.maxTexSize);
+    g_decodedPixelCache.put(filename, imgSurf->w, imgSurf->h,
+        (const uint8_t*)imgSurf->pixels,
+        (size_t)imgSurf->w * imgSurf->h * 4, _isMega);
+
+    if (imgSurf->w > glState.caps.maxTexSize || imgSurf->h > glState.caps.maxTexSize)
+    {
+        /* Mega surface */
+        p = new BitmapPrivate(this);
+        p->megaSurface = imgSurf;
+        SDL_SetSurfaceBlendMode(p->megaSurface, SDL_BLENDMODE_NONE);
+    }
+    else
+    {
+        /* Regular surface */
+        TEXFBO tex;
+        
+        try
+        {
+            tex = shState->texPool().request(imgSurf->w, imgSurf->h);
+        }
+        catch (const Exception &e)
+        {
+            SDL_FreeSurface(imgSurf);
+            throw e;
+        }
+        
+        p = new BitmapPrivate(this);
+        p->gl = tex;
+        
+        TEX::bind(p->gl.tex);
+        TEX::uploadImage(p->gl.width, p->gl.height, imgSurf->pixels, GL_RGBA);
+        
+        SDL_FreeSurface(imgSurf);
+    }
+    
+    p->addTaintedArea(rect());
+}
+
+Bitmap::Bitmap(int width, int height)
+{
+    if (width <= 0 || height <= 0)
+        throw Exception(Exception::RGSSError, "failed to create bitmap");
+    
+    TEXFBO tex = shState->texPool().request(width, height);
+    
+    p = new BitmapPrivate(this);
+    p->gl = tex;
+    
+    clear();
+    p->cpuPending = true;   // 新建位图：blit 先走 CPU，首次用纹理时整张上传（iOS 性能）
+}
+
+Bitmap::Bitmap(void *pixeldata, int width, int height)
+{
+    SDL_Surface *surface = SDL_CreateRGBSurface(0, width, height, p->format->BitsPerPixel,
+                                                p->format->Rmask,
+                                                p->format->Gmask,
+                                                p->format->Bmask,
+                                                p->format->Amask);
+    
+    if (!surface)
+        throw Exception(Exception::SDLError, "Error creating Bitmap: %s",
+                        SDL_GetError());
+    
+    memcpy(surface->pixels, pixeldata, width*height*(p->format->BitsPerPixel/8));
+    
+    if (surface->w > glState.caps.maxTexSize || surface->h > glState.caps.maxTexSize)
+    {
+        p = new BitmapPrivate(this);
+        p->megaSurface = surface;
+        SDL_SetSurfaceBlendMode(p->megaSurface, SDL_BLENDMODE_NONE);
+    }
+    else
+    {
+        TEXFBO tex;
+        
+        try
+        {
+            tex = shState->texPool().request(surface->w, surface->h);
+        }
+        catch (const Exception &e)
+        {
+            SDL_FreeSurface(surface);
+            throw e;
+        }
+        
+        p = new BitmapPrivate(this);
+        p->gl = tex;
+        
+        TEX::bind(p->gl.tex);
+        TEX::uploadImage(p->gl.width, p->gl.height, surface->pixels, GL_RGBA);
+        
+        SDL_FreeSurface(surface);
+    }
+    
+    p->addTaintedArea(rect());
+}
+
+// frame is -2 for "any and all", -1 for "current", anything else for a specific frame
+Bitmap::Bitmap(const Bitmap &other, int frame)
+{
+    other.guardDisposed();
+    other.ensureNonMega();
+    if (frame > -2) other.ensureAnimated();
+    
+    p = new BitmapPrivate(this);
+    
+    // TODO: Clean me up
+    if (!other.isAnimated() || frame >= -1) {
+        p->gl = shState->texPool().request(other.width(), other.height());
+        
+        GLMeta::blitBegin(p->gl);
+        // Blit just the current frame of the other animated bitmap
+        if (!other.isAnimated() || frame == -1) {
+            GLMeta::blitSource(other.getGLTypes());
+        }
+        else {
+            auto &frames = other.getFrames();
+            GLMeta::blitSource(frames[clamp(frame, 0, (int)frames.size() - 1)]);
+        }
+        GLMeta::blitRectangle(rect(), rect(), true);
+        GLMeta::blitEnd();
+    }
+    else {
+        p->animation.enabled = true;
+        p->animation.fps = other.getAnimationFPS();
+        p->animation.width = other.width();
+        p->animation.height = other.height();
+        p->animation.lastFrame = 0;
+        p->animation.playTime = 0;
+        p->animation.startTime = 0;
+        p->animation.loop = other.getLooping();
+        
+        for (TEXFBO &sourceframe : other.getFrames()) {
+            TEXFBO newframe;
+            try {
+                newframe = shState->texPool().request(p->animation.width, p->animation.height);
+            } catch(const Exception &e) {
+                for (TEXFBO &f : p->animation.frames)
+                    shState->texPool().release(f);
+                throw e;
+            }
+            
+            GLMeta::blitBegin(newframe);
+            GLMeta::blitSource(sourceframe);
+            GLMeta::blitRectangle(rect(), rect(), true);
+            GLMeta::blitEnd();
+            
+            p->animation.frames.push_back(newframe);
+        }
+    }
+    
+    p->addTaintedArea(rect());
+}
+
