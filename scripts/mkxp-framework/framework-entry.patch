+void ShaderBase::setTexSize(const Vec2i &value)
+{
+	gl.Uniform2f(u_texSizeInv, 1.f / value.x, 1.f / value.y);
+}
+
+void ShaderBase::setTranslation(const Vec2i &value)
+{
+	gl.Uniform2f(u_translation, value.x, value.y);
+}
