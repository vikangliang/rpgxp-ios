+/* ---- Decoded-pixel LRU cache (iOS perf) ----
+ * Stores post-ensureFormat ABGR8888 pixels keyed by normalized filename.
+ * Caches the most expensive part (RGSSAD decrypt + PNG decode) so that
+ * returning to a map / ending a battle re-uses decoded pixels instead of
+ * re-decoding from scratch. Each Bitmap gets its own copy of the cached
+ * bytes, so the cache only holds immutable pixels and can never be
+ * corrupted by a later blt/modification of a Bitmap. ---- */
+namespace {
+
+struct DecodedPixelCache
+{
+    struct Entry
+    {
+        int w, h;
+        std::vector<uint8_t> px; // ABGR8888
+    };
+
+    std::unordered_map<std::string, Entry> map;
+    std::list<std::string> lru; // front = most recent
+    int64_t totalBytes;
+    /* Pinned tilesets (mega-surfaces): never evicted by LRU pressure, so map
+     * re-entry never re-decodes the giant tileset (no 150ms hitch). Bounded by
+     * count (PINNED_MAX) to avoid the old OOM: pinning many tilesets + full LRU
+     * pushed the working set past 800MB. We keep only the few tilesets actually
+     * in play (~<=160MB) - safe, and kills the recurring re-decode stall. */
+    std::unordered_map<std::string, Entry> pinned;
+    std::list<std::string> pinnedLru; // FIFO for pinned
+    int64_t pinnedBytes;
+    int64_t hits, miss, ops;
+    static const int64_t CAP_BYTES = 96LL * 1024 * 1024;
+    static const size_t PINNED_MAX = 4;
+    SDL_mutex *mut;
+
+    DecodedPixelCache()
+        : totalBytes(0), pinnedBytes(0), hits(0), miss(0), ops(0)
+    { mut = SDL_CreateMutex(); }
+
+    static std::string normalizeKey(const std::string &k)
+    {
+        std::string s = k;
+        for (auto &c : s) if (c == '\\') c = '/';
+        while (s.size() >= 2 && s[0] == '.' && s[1] == '/') s = s.substr(2);
+        for (auto &c : s) if (c >= 'A' && c <= 'Z') c = (char)(c + 32);
+        return s;
+    }
+
+    bool get(const std::string &keyIn, int &w, int &h, std::vector<uint8_t> &out)
+    {
+        std::string key = normalizeKey(keyIn);
+        SDL_LockMutex(mut);
+        auto it = pinned.find(key);
+        bool hit = (it != pinned.end());
+        if (hit)
+        {
+            w = it->second.w; h = it->second.h; out = it->second.px;
+            hits++;
+            SDL_UnlockMutex(mut);
+            return true;
+        }
+        it = map.find(key);
+        hit = (it != map.end());
+        if (hit)
+        {
+            w = it->second.w; h = it->second.h; out = it->second.px;
+            lru.remove(key); lru.push_front(key);
+            hits++;
+        }
+        SDL_UnlockMutex(mut);
+        return hit;
+    }
+
+    void put(const std::string &keyIn, int w, int h, const uint8_t *p, size_t n, bool isMega = false)
+    {
+        std::string key = normalizeKey(keyIn);
+        SDL_LockMutex(mut);
+        int64_t add = (int64_t)n;
+        if (isMega)
+        {
+            /* Pin the giant tileset: never evicted by LRU pressure, so map
+             * re-entry never re-decodes it (no 150ms hitch). Bounded by
+             * PINNED_MAX count to keep memory safe (a few tilesets in play). */
+            auto eit = pinned.find(key);
+            if (eit != pinned.end())
+            {
+                pinnedBytes -= (int64_t)eit->second.px.size();
+                pinned.erase(eit); pinnedLru.remove(key);
+            }
+            Entry e; e.w = w; e.h = h; e.px.assign(p, p + n);
+            pinned[key] = e;
+            pinnedLru.remove(key); pinnedLru.push_front(key);
+            pinnedBytes += add;
+            while (pinned.size() > PINNED_MAX)
+            {
+                std::string oldk = pinnedLru.back();
+                auto oit = pinned.find(oldk);
+                if (oit == pinned.end()) { pinnedLru.pop_back(); continue; }
+                pinnedBytes -= (int64_t)oit->second.px.size();
+                pinned.erase(oit); pinnedLru.pop_back();
+            }
+            miss++; ops++;
+            if (ops % 32 == 0)
+                fprintf(stderr, "rgss: decode-cache hits=%lld miss=%lld (pinned=%zu)\n",
+                        (long long)hits, (long long)miss, pinned.size());
+            SDL_UnlockMutex(mut);
+            return;
+        }
+        if (add > CAP_BYTES) { miss++; ops++; SDL_UnlockMutex(mut); return; }
+        while (totalBytes + add > CAP_BYTES && lru.size() > 0)
+        {
+            std::string oldk = lru.back();
+            auto oit = map.find(oldk);
+            if (oit == map.end()) { lru.pop_back(); continue; }
+            totalBytes -= (int64_t)oit->second.px.size();
+            map.erase(oit);
+            lru.pop_back();
+        }
+        Entry e; e.w = w; e.h = h; e.px.assign(p, p + n);
+        map[key] = e;
+        lru.remove(key); lru.push_front(key);
+        totalBytes += add;
+        miss++; ops++;
+        if (ops % 32 == 0)
+            fprintf(stderr, "rgss: decode-cache hits=%lld miss=%lld\n", (long long)hits, (long long)miss);
+        SDL_UnlockMutex(mut);
+    }
+
+    /* A/B 开关切换 spng 时清空缓存：确保后续 bitmap 用新设置重新解码 */
+    void clear()
+    {
+        SDL_LockMutex(mut);
+        map.clear();
+        lru.clear();
+        totalBytes = 0;
+        pinned.clear();
+        pinnedLru.clear();
+        pinnedBytes = 0;
+        SDL_UnlockMutex(mut);
+    }
+};
