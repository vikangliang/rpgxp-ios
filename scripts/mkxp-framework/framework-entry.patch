-void ShaderBase::GLProjMat::apply(const Vec2i &value)
-{
-	/* glOrtho replacement */
-	const float a = 2.f / value.x;
-	const float b = 2.f / value.y;
-	const float c = -2.f;
-
-	GLfloat mat[16] =
-	{
-		 a,  0,  0,  0,
-		 0,  b,  0,  0,
-		 0,  0,  c,  0,
-		-1, -1, -1,  1
-	};
-
-	gl.UniformMatrix4fv(u_mat, 1, GL_FALSE, mat);
-}
