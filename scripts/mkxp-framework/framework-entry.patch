+     * 独立 SDL UIWindow 盖屏（那种做法画面进不到可见层级，实测整屏空窗）。UIKit 视图
+     * 操作只能 ObjC++ 编译，抽到 ios_embed.mm；main.cpp 实际被 iOS 工具链按 C 编译，
+     * 故此处只写【纯 C 前向声明】，定义侧 extern "C" 同得 flat 名、默认可见，链接匹配。 */
+    void mkxp_ios_embedIntoView(SDL_Window *win);
+    mkxp_ios_embedIntoView(win);
+#endif
+
+#ifdef MKXPZ_BUILD_XCODE
+    {
+        std::string downloadsPath = "/Users/" + mkxp_sys::getUserName() + "/Downloads";
+        
+        if (mkxp_fs::getCurrentDirectory().find(downloadsPath) == 0) {
+            showInitError(conf.game.title +
+                          " cannot run from the Downloads directory.\n\n" +
+                          "Please move the application to the Applications folder (or anywhere else) " +
+                          "and try again.");
+#ifdef MKXPZ_STEAM
+            STEAMSHIM_deinit();
+#endif
+            return 0;
+        }
+    }
+#endif
+    
+#if defined(MKXPZ_BUILD_XCODE)
+#define DEBUG_FSELECT_MSG "Select the folder from which to load game files. This is the folder containing the game's INI."
+#define DEBUG_FSELECT_PROMPT "Load Game"
+    if (conf.manualFolderSelect) {
+        std::string dataDirStr = mkxp_fs::selectPath(win, DEBUG_FSELECT_MSG, DEBUG_FSELECT_PROMPT);
+        if (!dataDirStr.empty()) {
+            conf.gameFolder = dataDirStr;
+            mkxp_fs::setCurrentDirectory(dataDirStr.c_str());
+            Debug() << "Current directory set to" << dataDirStr;
+            conf.read(argc, argv);
+            conf.readGameINI();
+        }
+    }
+#endif
+
+    /* OSX and Windows have their own native ways of
+     * dealing with icons; don't interfere with them */
+#ifdef __LINUX__
+    setupWindowIcon(conf, win);
+#else
+    (void)setupWindowIcon;
+#endif
+
+    ALCdevice *alcDev = alcOpenDevice(0);
+
+    if (!alcDev) {
+      showInitError("Could not detect an available audio device.");
+      SDL_DestroyWindow(win);
+      TTF_Quit();
+      IMG_Quit();
+      SDL_Quit();
+
+#ifdef MKXPZ_STEAM
+      STEAMSHIM_deinit();
+#endif
+      return 0;
+    }
+
+    SDL_DisplayMode mode;
+    SDL_GetDisplayMode(0, 0, &mode);
+
+    /* Can't sync to display refresh rate if its value is unknown */
+    if (!mode.refresh_rate)
+      conf.syncToRefreshrate = false;
+
+    // 引擎事件循环（eventThread.process）必须离开主线程：否则 iOS 主线程 run loop
+    // 被占死，Core Animation 无法上屏（黑屏/界面冻结）。SDL 初始化 + 建窗 + 起
+    // RGSS 线程都留在主线程（UIKit 安全），循环与终止清理甩到后台线程。状态用堆分配，
+    // 跨 mkxp_z_main 返回存活；g_engineRunning 由后台线程在引擎退出时复位。
+    EventThread *evThread = new EventThread();
+    fprintf(stderr, "[stage] %ums evThread ok (window+openal done, initGL next)\n", (unsigned) SDL_GetTicks());
+
+#ifndef MKXPZ_INIT_GL_LATER
+    SDL_GLContext glCtx = initGL(win, conf, 0);
+#else
+    SDL_GLContext glCtx = NULL;
+#endif
+
+    RGSSThreadData *rtData = new RGSSThreadData(evThread, argv[0], win, alcDev,
+                                               mode.refresh_rate,
+                                               mkxp_sys::getScalingFactor(),
+                                               conf, glCtx);
+    fprintf(stderr, "[stage] %ums rtData ok (GL context ready)\n", (unsigned) SDL_GetTicks());
+
+    int winW, winH, drwW, drwH;
+    SDL_GetWindowSize(win, &winW, &winH);
+    rtData->windowSizeMsg.post(Vec2i(winW, winH));
+
+    SDL_GL_GetDrawableSize(win, &drwW, &drwH);
+    rtData->drawableSizeMsg.post(Vec2i(drwW, drwH));
+
+    /* Load and post key bindings */
+    rtData->bindingUpdateMsg.post(loadBindings(conf));
+
+#ifdef MKXPZ_BUILD_XCODE
+    // Create Touch Bar
+    initTouchBar(win, conf);
+#endif
+
+    /* Start RGSS thread */
+    SDL_Thread *rgssThread = SDL_CreateThread(rgssThreadFun, "rgss", rtData);
+    fprintf(stderr, "[stage] %ums rgss thread spawned (ruby+scripts load starts)\n", (unsigned) SDL_GetTicks());
+
+    std::thread engineLoop([evThread, rtData, rgssThread]() {
+        evThread->process(*rtData);
+
+        /* Request RGSS thread to stop */
+        rtData->rqTerm.set();
+
+        /* Wait for RGSS thread response */
+        for (int i = 0; i < 1000; ++i) {
+          /* We can stop waiting when the request was ack'd */
+          if (rtData->rqTermAck) {
+            Debug() << "RGSS thread ack'd request after" << i * 10 << "ms";
+            break;
+          }
+
+          /* Give RGSS thread some time to respond */
+          SDL_Delay(10);
+        }
+
+        /* If RGSS thread ack'd request, wait for it to shutdown,
+         * otherwise abandon hope and just end the process as is. */
+        if (rtData->rqTermAck)
+          SDL_WaitThread(rgssThread, 0);
+        else
+          /* iOS：SDL_ShowSimpleMessageBox 必须在主线程调用（后台线程会崩/不显示），
+           * 这里只写日志；stderr 已由 mkxp_run 重定向到 Documents/mkxp.log。 */
+          Debug() << "The RGSS script seems to be stuck. " << rtData->config.game.title
+                  << " will now force quit.";
+
+        if (!rtData->rgssErrorMsg.empty()) {
+          Debug() << rtData->rgssErrorMsg;
+        }
+
+        if (rtData->glContext)
+          SDL_GL_DeleteContext(rtData->glContext);
+
+        /* Clean up any remainin events */
+        evThread->cleanup();
+
+        Debug() << "Shutting down.";
+
+        alcCloseDevice(rtData->alcDev);
+        SDL_DestroyWindow(rtData->window);
+
+#if defined(__WIN32__)
+        if (wsadata.wVersion)
+          WSACleanup();
+#endif
+
+#ifdef MKXPZ_STEAM
+        STEAMSHIM_deinit();
+#endif
+        Sound_Quit();
+        TTF_Quit();
+        IMG_Quit();
+        SDL_Quit();
+
+        g_engineRunning.store(false);
+        delete rtData;
+        delete evThread;
+    });
+    engineLoop.detach();
+    fprintf(stderr, "[stage] %ums main-thread init complete, main loop free\n", (unsigned) SDL_GetTicks());
+
+    return 0;
+}
+
+static SDL_GLContext initGL(SDL_Window *win, Config &conf,
+                            RGSSThreadData *threadData) {
+  SDL_GLContext glCtx{};
+
+  /* Setup GL context. Must be done in main thread since macOS 10.15 */
+  SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+    
+  if (conf.debugMode)
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_FLAGS, SDL_GL_CONTEXT_DEBUG_FLAG);
+
+  glCtx = SDL_GL_CreateContext(win);
+
+  if (!glCtx) {
+    GLINIT_SHOWERROR(std::string("Could not create OpenGL context: ") + SDL_GetError());
+    return 0;
+  }
+
+  try {
+    initGLFunctions();
+  } catch (const Exception &exc) {
+    GLINIT_SHOWERROR(exc.msg);
+    SDL_GL_DeleteContext(glCtx);
+
+    return 0;
+  }
+
+// This breaks scaling for Retina screens.
+// Using Metal should be rendering this irrelevant anyway, hopefully
+#ifndef MKXPZ_BUILD_XCODE
+  if (!conf.enableBlitting)
+    gl.BlitFramebuffer = 0;
+#endif
+
+  // Diagnostic: confirm whether the fast native-blit path is available.
+  // If this logs nativeBlit=0 on iOS, Bitmap#blt falls back to the slow
+  // shader path and the autotile-expansion jank persists.
+  fprintf(stderr, "[mkxp] nativeBlit=%d glsl=%d\n", (gl.BlitFramebuffer != 0), (int)gl.glsles);
+
+  gl.ClearColor(0, 0, 0, 1);
+  gl.Clear(GL_COLOR_BUFFER_BIT);
+  SDL_GL_SwapWindow(win);
+
+  printGLInfo();
+
+  bool vsync = conf.vsync || conf.syncToRefreshrate;
+#ifdef MKXPZ_IOS_EMBED
+  /* iOS: force VSync on to eliminate screen tearing (esp. outdoor maps).
+   * Double buffering is already enabled; interval=1 flips on vblank. */
+  vsync = true;
+#endif
+  SDL_GL_SetSwapInterval(vsync ? 1 : 0);
+  fprintf(stderr, "[mkxp] swapInterval=%d\n", vsync ? 1 : 0);
+
+  // GLDebugLogger dLogger;
+  return glCtx;
+}

