+}
+
+void Bitmap::fillRect(const IntRect &rect, const Vec4 &color)
+{
+    guardDisposed();
+    p->endCpuPending();
+    
+    GUARD_MEGA;
+    GUARD_ANIMATED;
+    
+    p->fillRect(rect, color);
+    
+    if (color.w == 0)
+    /* Clear op */
+        p->substractTaintedArea(rect);
+    else
+    /* Fill op */
+        p->addTaintedArea(rect);
+    
+    p->onModified();
+}
