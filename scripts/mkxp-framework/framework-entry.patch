-int ZLayer::calculateZ(TilemapPrivate *p, int index)
-{
-	return 32 * (index + p->viewpPos.y + 1) - p->origin.y;
-}
-
-void ZLayer::initUpdateZ()
-{
-	unlink();
-}
-
-void ZLayer::finiUpdateZ(ZLayer *prev)
-{
-	z = calculateZ(p, index);
-
-	if (prev)
-		scene->insertAfter(*this, *prev);
-	else
-		scene->insert(*this);
-}
