+    // Static zlib ext (iOS --with-static-linked-ext): define Zlib module + provide
+    // the "zlib" feature so require 'zlib' (here and in game scripts) succeeds
+    // without a zlib.so/bundle to load. Init_zlib / rb_provide_feature live in
+    // libruby-static.a (-force_load); extern "C" so this C++ TU links them by
+    // their unmangled names (the earlier "static lib doesn't export it" link
+    // error was just a missing extern "C" -- name mangling -- not a missing symbol).
+    if (!rb_const_defined(rb_cObject, rb_intern("Zlib"))) {
+        static bool s_zlibInit = false;
+        if (!s_zlibInit) {
+            typedef void (*VoidFn)(void);
+            typedef void (*FeatFn)(VALUE);
+            VoidFn initZlib = (VoidFn)dlsym(RTLD_DEFAULT, "Init_zlib");
+            FeatFn provideFeature = (FeatFn)dlsym(RTLD_DEFAULT, "rb_provide_feature");
+            if (initZlib) initZlib();
+            if (provideFeature) provideFeature(rb_str_new_cstr("zlib"));
+            s_zlibInit = true;
+            Debug() << "rgss: zlib static init done";
+        }
+    }
+
+    // Encoding constants: the cross-compiled static Ruby may register encodings
+    // without defining their Encoding::* constants (game scripts reference
+    // Encoding::UTF_8 early -> NameError). Ensure the common ones exist; if an
+    // encoding itself is not registered, log a WARNING (that means the build is
+    // missing the enc objects and needs a build-script fix).
+    {
+        static const char *encs[] = {"UTF-8", "US-ASCII", "ASCII-8BIT", "UTF-16LE",
+                                     "UTF-16BE", "EUC-JP", "Shift_JIS", "Windows-31J", 0};
+        VALUE encClass = rb_const_get(rb_cObject, rb_intern("Encoding"));
+        for (int i = 0; encs[i]; ++i) {
+            rb_encoding *e = rb_enc_find(encs[i]);
+            if (!e) { Debug() << "rgss: WARNING encoding" << encs[i] << "not registered"; continue; }
+            char cname[64];
+            snprintf(cname, sizeof(cname), "%s", encs[i]);
+            for (char *p = cname; *p; ++p) { if (*p == '-') *p = '_'; }
+            if (!rb_const_defined(encClass, rb_intern(cname))) {
+                rb_define_const(encClass, cname, rb_enc_from_encoding(e));
+                Debug() << "rgss: defined Encoding::" << cname;
+            }
+        }
+        Debug() << "rgss: encoding constants guard done";
+    }
+
     // Automatically load zlib if it's present -- the correct way this time
