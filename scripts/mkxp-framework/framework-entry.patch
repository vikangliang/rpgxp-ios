+/* iOS audio interruption / route-change bridge.
+ * Called from ios_embed.mm when AVAudioSession is interrupted or the route
+ * changes (phone call, AirPods switch, headphone unplug). Reuses the exact
+ * pause/resume logic from the SDL app-lifecycle handling above so the
+ * OpenAL device stays valid and BGM can self-heal instead of going silent. */
+extern "C" void mkxp_ios_audioInterruptBegin()
+{
+    if (HAVE_ALC_DEVICE_PAUSE)
+        alc.DevicePause(shState->rtData().alcDev);
+
+    shState->rtData().syncPoint.haltThreads();
+}
+
+extern "C" void mkxp_ios_audioInterruptEnd()
+{
+    shState->rtData().syncPoint.resumeThreads();
+
+    if (HAVE_ALC_DEVICE_PAUSE)
+        alc.DeviceResume(shState->rtData().alcDev);
+}
