+
+void Bitmap::blt(int x, int y,
+                 const Bitmap &source, IntRect rect,
+                 int opacity)
+{
+    if (source.isDisposed())
+        return;
+    
+    // FIXME: RGSS allows the source rect to both lie outside
+    // the bitmap rect and be inverted in both directions;
+    // clamping only covers a subset of these cases (and
+    // doesn't fix anything for a direct stretch_blt call).
+    
+    /* Clamp rect to source bitmap size */
+    if (rect.x + rect.w > source.width())
+        rect.w = source.width() - rect.x;
+    
+    if (rect.y + rect.h > source.height())
+        rect.h = source.height() - rect.y;
+    
+    stretchBlt(IntRect(x, y, rect.w, rect.h),
+               source, rect, opacity);
+}
+
+void Bitmap::stretchBlt(const IntRect &destRect,
+                        const Bitmap &source, const IntRect &sourceRect,
+                        int opacity)
+{
+    guardDisposed();
+    
+    // Don't need this, right? This function is fine with megasurfaces it seems
+    //GUARD_MEGA;
+    
+    /* ---- 光标冻结全方位诊断（2026-10-24，诊断完可整段删）----
+     * 一次埋满：入口状态 + 每条路径 + GL 错误，配合 Ruby 侧 blt 前后像素，
+     * 可一锤定音区分「按键/RGSS/路径/像素/上屏」哪一层出问题。
+     * 限频（前 3000 次，覆盖到登录/标题/菜单的一次性背景）+ 只 fprintf，
+     * 不做 ReadPixels（避免干扰被测路径）。 */
+    static int bltDiagN = 0;
+    bool bltDiag = (bltDiagN++ < 3000);
+    if (bltDiag) {
+        /* 字段：dst=目标位图尺寸 dstRect=目标矩形 src=源位图尺寸 srcRect=源矩形
+         * oob=1 表示源矩形越界。注意参数顺序必须与格式串一致：
+         * dst,dstRect,src,srcRect —— 早前把 src 放在 dstRect 之前导致字段整体错位，
+         * 日志被误读成"源矩形 y=444 越界"，实际源是 408x536 并未越界。 */
+        fprintf(stderr, "[blt-diag] cc IN n=%d dst=%dx%d#%p dstRect=(%d,%d,%d,%d) src=%dx%d "
+                "srcRect=(%d,%d,%d,%d) op=%d cpuPend=%d srcMega=%d srcCpu=%d dstCpu=%d oob=%d\n",
+                bltDiagN, width(), height(), (void*)this,
+                destRect.x, destRect.y, destRect.w, destRect.h,
+                source.width(), source.height(),
+                sourceRect.x, sourceRect.y, sourceRect.w, sourceRect.h,
+                opacity, (int)p->cpuPending, source.megaSurface() ? 1 : 0, source.p->surface ? 1 : 0, p->surface ? 1 : 0,
+                ((sourceRect.x < 0) || (sourceRect.y < 0) || (sourceRect.x + sourceRect.w > source.width()) || (sourceRect.y + sourceRect.h > source.height())) ? 1 : 0);
+    }
+    
+    /* ---- Bug2：blit/stretch_blt 矩形越界规范化（RMXP 语义=裁剪）----
+     * MKXP 的 GPU 路径对越界/负尺寸的 sourceRect 不做裁剪，会采到相邻或
+     * 未定义像素 -> 屏幕上出现"错位的一整行"（室外横线）。
+     * Bitmap#blit 内部走的也是本函数，所以这里一处修正同时覆盖
+     * Bitmap#blit 与 Bitmap#stretch_blt 两条路径。
+     * 做法：把 sourceRect 裁剪进源位图范围，目标矩形按同比例缩放后递归
+     * （规范化后不再越界，故不会死循环）；空/负尺寸直接返回（与 RGSS 一致）。 */
+    if (sourceRect.w <= 0 || sourceRect.h <= 0 || destRect.w <= 0 || destRect.h <= 0)
+        return;
+
+    if (sourceRect.x < 0 || sourceRect.y < 0 ||
+        sourceRect.x + sourceRect.w > source.width() ||
+        sourceRect.y + sourceRect.h > source.height())
+    {
+        int sx  = (sourceRect.x > 0) ? sourceRect.x : 0;
+        int sy  = (sourceRect.y > 0) ? sourceRect.y : 0;
+        int sx2 = (sourceRect.x + sourceRect.w < source.width()) ? (sourceRect.x + sourceRect.w) : source.width();
+        int sy2 = (sourceRect.y + sourceRect.h < source.height()) ? (sourceRect.y + sourceRect.h) : source.height();
+        if (sx2 <= sx || sy2 <= sy)
+            return;
+        IntRect sFix(sx, sy, sx2 - sx, sy2 - sy);
+        IntRect dFix(destRect.x + (sx - sourceRect.x) * destRect.w / sourceRect.w,
+                     destRect.y + (sy - sourceRect.y) * destRect.h / sourceRect.h,
+                     (sx2 - sx) * destRect.w / sourceRect.w,
+                     (sy2 - sy) * destRect.h / sourceRect.h);
+        if (dFix.w <= 0 || dFix.h <= 0)
+            return;
+        stretchBlt(dFix, source, sFix, opacity);
+        return;
+    }
+
+    if (source.isDisposed())
+        return;
+    
+    opacity = clamp(opacity, 0, 255);
+    
+    if (opacity == 0)
+        return;
+
+    /* iOS 性能：新建位图（尚未用作纹理）的 1:1 blit 走 CPU，
+     * 避免 AutotileExpander 数千次 GPU draw call（Metal-GL ~1ms/次）。
+     * 任何不能走 CPU 的情况（源无 CPU 数据、半透明混合）先上传累积
+     * 内容再走 GPU，避免 CPU 侧结果被 GPU 覆盖后丢失。 */
+    if (p->cpuPending)
+    {
+        if (opacity == 255 && !source.isDisposed() && p->cpuBlitToPending(destRect, source, sourceRect))
+        {
+            p->addTaintedArea(destRect);
+            if (bltDiag) fprintf(stderr, "[blt-diag] cc PATH=A(cpuPending/CPU-blit) n=%d\n", bltDiagN);
+            return;
+        }
+        p->endCpuPending();   // 先 flush CPU 累积，再走 GPU 路径
+    }
+
+    SDL_Surface *srcSurf = source.megaSurface();
+    
+    if (srcSurf && shState->config().subImageFix)
+    {
+        /* Blit from software surface, for broken GL drivers */
+        Vec2i gpTexSize;
+        shState->ensureTexSize(sourceRect.w, sourceRect.h, gpTexSize);
+        shState->bindTex();
+        
+        GLMeta::subRectImageUpload(srcSurf->w, sourceRect.x, sourceRect.y, 0, 0,
+                                   sourceRect.w, sourceRect.h, srcSurf, GL_RGBA);
+        GLMeta::subRectImageEnd();
+        
+        SimpleShader &shader = shState->shaders().simple;
+        shader.bind();
+        shader.setTranslation(Vec2i());
+        shader.setTexSize(gpTexSize);
+        
+        p->pushSetViewport(shader);
+        p->bindFBO();
+        
+        Quad &quad = shState->gpQuad();
+        quad.setTexRect(FloatRect(0, 0, sourceRect.w, sourceRect.h));
+        quad.setPosRect(destRect);
+        
+        p->blitQuad(quad);
+        p->popViewport();
+        
+        p->addTaintedArea(destRect);
+        p->onModified();
+        
+        if (bltDiag) fprintf(stderr, "[blt-diag] cc PATH=B(subImageFix/GPU-shader) n=%d glErr=0x%x\n", bltDiagN, glGetError());
+        return;
+    }
+    else if (srcSurf)
+    {
+        /* Blit from software surface */
+        /* Don't do transparent blits for now */
+        if (opacity < 255)
+            source.ensureNonMega();
+        
+        SDL_Rect srcRect = sourceRect;
+        SDL_Rect dstRect = destRect;
+        SDL_Rect btmRect = { 0, 0, width(), height() };
+        SDL_Rect bltRect;
+        
+        if (SDL_IntersectRect(&btmRect, &dstRect, &bltRect) != SDL_TRUE)
+            return;
+        
+        int bpp;
+        Uint32 rMask, gMask, bMask, aMask;
+        SDL_PixelFormatEnumToMasks(SDL_PIXELFORMAT_ABGR8888,
+                                   &bpp, &rMask, &gMask, &bMask, &aMask);
+        SDL_Surface *blitTemp =
+        SDL_CreateRGBSurface(0, destRect.w, destRect.h, bpp, rMask, gMask, bMask, aMask);
+        
+        SDL_BlitScaled(srcSurf, &srcRect, blitTemp, 0);
+        
+        TEX::bind(getGLTypes().tex);
+        
+        if (bltRect.w == dstRect.w && bltRect.h == dstRect.h)
+        {
+            /* Dest rectangle lies within bounding box */
+            TEX::uploadSubImage(destRect.x, destRect.y,
+                                destRect.w, destRect.h,
+                                blitTemp->pixels, GL_RGBA);
+        }
+        else
+        {
+            /* Clipped blit */
+            GLMeta::subRectImageUpload(blitTemp->w, bltRect.x - dstRect.x, bltRect.y - dstRect.y,
+                                       bltRect.x, bltRect.y, bltRect.w, bltRect.h, blitTemp, GL_RGBA);
+            GLMeta::subRectImageEnd();
+        }
+        
+        SDL_FreeSurface(blitTemp);
+        
+        p->onModified();
+        if (bltDiag) fprintf(stderr, "[blt-diag] cc PATH=C(uploadSubImage) n=%d glErr=0x%x\n", bltDiagN, glGetError());
+        return;
+    }
+    
+    if (opacity == 255 && !p->touchesTaintedArea(destRect))
+    {
+        /* Fast blit */
+        GLMeta::blitBegin(getGLTypes());
+        GLMeta::blitSource(source.getGLTypes());
+        GLMeta::blitRectangle(sourceRect, destRect);
+        GLMeta::blitEnd();
+        if (bltDiag) fprintf(stderr, "[blt-diag] cc PATH=D(fastBlit) n=%d glErr=0x%x\n", bltDiagN, glGetError());
+    }
+    else
+    {
+        /* Fragment pipeline */
+        float normOpacity = (float) opacity / 255.0f;
+        
+        TEXFBO &gpTex = shState->gpTexFBO(destRect.w, destRect.h);
+        
+        GLMeta::blitBegin(gpTex);
+        GLMeta::blitSource(getGLTypes());
+        GLMeta::blitRectangle(destRect, Vec2i());
+        GLMeta::blitEnd();
+        
+        FloatRect bltSubRect((float) sourceRect.x / source.width(),
+                             (float) sourceRect.y / source.height(),
+                             ((float) source.width() / sourceRect.w) * ((float) destRect.w / gpTex.width),
+                             ((float) source.height() / sourceRect.h) * ((float) destRect.h / gpTex.height));
+        
+        BltShader &shader = shState->shaders().blt;
+        shader.bind();
+        shader.setDestination(gpTex.tex);
+        shader.setSubRect(bltSubRect);
+        shader.setOpacity(normOpacity);
+        
+        Quad &quad = shState->gpQuad();
+        quad.setTexPosRect(sourceRect, destRect);
+        quad.setColor(Vec4(1, 1, 1, normOpacity));
+        
+        source.p->bindTexture(shader);
+        p->bindFBO();
+        p->pushSetViewport(shader);
+        
+        p->blitQuad(quad);
+        
+        p->popViewport();
+        if (bltDiag) fprintf(stderr, "[blt-diag] cc PATH=E(fragment/BltShader) n=%d glErr=0x%x\n", bltDiagN, glGetError());
+    }
+    
+    p->addTaintedArea(destRect);
+    p->onModified();
+}
+
+void Bitmap::fillRect(int x, int y,
+                      int width, int height,
+                      const Vec4 &color)
+{
