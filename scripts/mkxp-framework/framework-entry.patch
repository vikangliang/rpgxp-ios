diff --git a/src/audio/alstream.cpp b/src/audio/alstream.cpp
index 73dfe41..7745e71 100644
--- a/src/audio/alstream.cpp
+++ b/src/audio/alstream.cpp
@@ -42,7 +42,7 @@ ALStream::ALStream(LoopMode loopMode,
 	  source(0),
 	  thread(0),
 	  preemptPause(false),
-      pitch(1.0f)
+      pitch(1.0f), healRetries(0), lastHealTicks(0)
 {
 	alSrc = AL::Source::gen();
 
@@ -344,17 +344,62 @@ void ALStream::checkStopped()
 	if (!streamInited)
 		return;
 
-	/* If alSrc isn't playing, but we haven't
-	 * exhausted the data source yet, we're just
-	 * having a buffer underrun */
-	if (!sourceExhausted)
+	/* If streaming thread hasn't queued up
+	 * buffers yet there's not point in querying
+	 * the AL source */
+	/* Only a logically-Playing stream can die unexpectedly. Paused/Stopped
+	 * tracks are explicitly managed (ME/jingle pause, user stop) and must
+	 * NOT be restarted here: the previous unconditional heal restarted the
+	 * BGM under a playing ME (jingle replaces BGM, repeated restarts) and
+	 * looped finished non-looping tracks (device-verified 2026-10-19 via
+	 * "bgm heal attempt" spam while alstate=AL_STOPPED). */
+	if (state != Playing)
+	{
+		healRetries = 0;
+		lastHealTicks = 0;
 		return;
+	}
 
-	if (AL::Source::getState(alSrc) == AL_PLAYING)
+	ALenum s = AL::Source::getState(alSrc);
+	if (s == AL_PLAYING)
+	{
+		healRetries = 0;
+		lastHealTicks = 0;
 		return;
+	}
 
+	/* End of a non-looping track (data exhausted): stop cleanly. */
+	if (sourceExhausted)
+	{
+		stopStream();
+		state = Stopped;
+		return;
+	}
+
+	/* Playing but the AL source died before data end: transient underrun
+	 * or the iOS audio-vacuum after an interruption/device invalidation.
+	 * Heal by restarting the stream, throttled to once per 2s, capped at
+	 * 30 tries (~60s) so we keep retrying without busy-looping forever. */
+	if (healRetries >= 30)
+	{
+		Debug() << "rgss: bgm heal gave up after" << healRetries;
+		stopStream();
+		state = Stopped;
+		return;
+	}
+	uint32_t now = SDL_GetTicks();
+	if (now - lastHealTicks < 2000)
+		return;
+	lastHealTicks = now;
+	healRetries++;
+	Debug() << "rgss: bgm heal attempt" << healRetries << "alstate=" << s;
+	/* Resume from the CURRENT decode position, not startOffset: an underrun
+	 * must not restart the track from the beginning (the audible "repeat")
+	 * the user hears). queryOffset() is captured BEFORE stopStream() zeroes
+	 * procFrames, so we continue seamlessly where playback died. */
+	float resumeOff = queryOffset();
 	stopStream();
-	state = Stopped;
+	startStream(resumeOff);
 }
 
 /* thread func */
