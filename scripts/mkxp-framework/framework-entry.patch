-void Tilemap::update()
-{
-	guardDisposed();
-
-	if (!p->tilemapReady)
-		return;
-
-	/* Animate flash */
-	if (++p->flashAlphaIdx >= flashAlphaN)
-		p->flashAlphaIdx = 0;
-
-	/* Animate autotiles */
-	if (!p->tiles.animated)
-		return;
-
-	++p->tiles.aniIdx;
