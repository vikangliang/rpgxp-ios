-void ZLayer::draw()
-{
-	if (batchedFlag)
-		return;
-
-	ShaderBase *shader;
-
-	p->bindShader(shader);
-	p->bindAtlas(*shader);
-
-	glState.blendMode.pushSet(p->blendType);
-
-	GLMeta::vaoBind(p->tiles.vao);
-
-	shader->setTranslation(p->dispPos);
